# Uploaded media only — scripts here must never run.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|htaccess|html?|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# .jfif files are ordinary JPEGs — make sure browsers show them instead of downloading.
AddType image/jpeg .jfif .jpe
